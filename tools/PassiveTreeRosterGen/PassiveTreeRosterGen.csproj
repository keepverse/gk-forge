<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FusionRpg.Tools.PassiveTreeRosterGen</RootNamespace>
    <AssemblyName>PassiveTreeRosterGen</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core only, same shape as ElementEnumGen: reads the shipped StatusCategoryRegistry and
         AtomKindRegistry/AttachPoint/AtomTriggers, all Core, and the two data/seed/** mirror files.
         No SQL, no Data reference, nothing for guard-dal.ps1 to police. -->
    <ProjectReference Include="$(GkCoreRoot)src\FusionRpg.Core\FusionRpg.Core.csproj" />
  </ItemGroup>
</Project>
