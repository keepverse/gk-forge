    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FusionRpg.Tools.ItemSeedValidator</RootNamespace>
    <AssemblyName>ItemSeedValidator</AssemblyName>
