# seedsmith local model settings (seedsmith.pipeline.llm_caller.load_config).
#
# Copy this file to `.env` in this directory and edit — `.env` is gitignored (repo root
# .gitignore's bare `.env` pattern) so machine-specific endpoints/models never get committed.
# Every key here overrides seedsmith.toml's [pipeline.llm_caller] table, which overrides
# LlmCallerConfig's own built-in defaults — .env is for "this machine only," seedsmith.toml is
# for "this project's committed default."
#
# All keys are optional; an unset key falls through to the next layer.

# The local OpenAI-compatible endpoint (LM Studio default shown).
SEEDSMITH_LLM_ENDPOINT=http://localhost:1234/v1/chat/completions

# Which loaded model to call — must match an id LM Studio reports at /v1/models.
SEEDSMITH_LLM_MODEL=google/gemma-4-26b-a4b-qat

# Seconds to wait for one call before giving up (a 26B model at high context is slow).
SEEDSMITH_LLM_TIMEOUT=420

# Retry attempts on a transport failure (timeout/connection error), not a content defect.
SEEDSMITH_LLM_ATTEMPTS=2

# Seconds to wait between transport-failure retries.
SEEDSMITH_LLM_RETRY_DELAY=3

# Self-heal rounds after a verify failure before falling back to the no-silent-drop default.
SEEDSMITH_LLM_MAX_HEAL=3

# Hard cap on tokens per response — the only thing that stops a degenerate generation (a
# quantized model stuck repeating a short token cycle) once it starts. Independent of any
# per-field schema maxLength; this bounds the WHOLE response.
SEEDSMITH_LLM_MAX_TOKENS=16384

# --- items generate / items fill (adapters.items.defaults) ---
# Permit writes into data/seed/items/ without typing --allow-production-tree every run.
# Required for production out-dir defaults below. Set to 0 / omit to keep the sample-only gate.
SEEDSMITH_ALLOW_PRODUCTION_TREE=1

# Optional: force one out-dir for set/charm/combination. When unset, each kind uses its
# production folder (sets/, charms/, combinations/) under data/seed/items/.
# SEEDSMITH_ITEMS_OUT_DIR=
