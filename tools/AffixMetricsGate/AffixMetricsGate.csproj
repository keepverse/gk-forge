<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FusionRpg.Tools.AffixMetricsGate</RootNamespace>
    <AssemblyName>AffixMetricsGate</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- T3.8 (affix-metrics) "register with declared targets" — a thin CLI wrapper over
         ContentMetrics.FamilyCoverageOf/ContainerFillRatesOf (already built, tested) and the new
         AffixMetricsGateEvaluator (data/tuning/affix-metrics.v1.json). Reuses SeedImportRunner
         (FusionRpg.Data.Seed) to collect the real committed data/seed/** tree into a pure SeedContent
         — no database, matching CreatureRecipeDistributionIndex's own "report tool, never a gate on the
         database" shape. -->
    <ProjectReference Include="$(GkCoreRoot)src\FusionRpg.Core\FusionRpg.Core.csproj" />
    <ProjectReference Include="$(GkCoreRoot)src\FusionRpg.Data\FusionRpg.Data.csproj" />
  </ItemGroup>
</Project>
